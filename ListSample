import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.LinkedList;
import javax.swing.*;

/**
 *
 * @author Edmundo Dela Cruz
 */
public class listSampleApp extends JFrame implements ActionListener {
    
    private DefaultListModel<String> listModel;
    private LinkedList<String> linkedList;
    private JList<String> list;
    private JScrollPane scrollPane;
    private JTextField txtField;
    private JButton btnAdd, btnRemove;
    
    public listSampleApp() {
        linkedList = new LinkedList<>();
        listModel = new DefaultListModel<>();
        
        setTitle("List Sample App");
        setSize(300, 350);
        setLayout(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        
        // Create JList and ScrollPane
        list = new JList<>(listModel);
        list.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        scrollPane = new JScrollPane(list);
        scrollPane.setBounds(10, 10, 265, 180);
        add(scrollPane);
        
        // Create text field
        txtField = new JTextField();
        txtField.setBounds(10, 200, 160, 30);
        add(txtField);
        
        // Create buttons
        btnAdd = new JButton("Add");
        btnAdd.setBounds(180, 200, 95, 30);
        add(btnAdd);
        
        btnRemove = new JButton("Remove");
        btnRemove.setBounds(180, 240, 95, 30);
        add(btnRemove);
        
        // Add ActionListeners
        btnAdd.addActionListener(this); 
        btnRemove.addActionListener(this); 
        txtField.addActionListener(this);
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == btnAdd || e.getSource() == txtField) {
            String listItem = txtField.getText().trim();
            
            if (!listItem.isEmpty()) {
                linkedList.add(listItem);
                listModel.addElement(listItem);
                txtField.setText("");
                txtField.requestFocusInWindow();
            } else {
                JOptionPane.showMessageDialog(this, "Please enter item first", "Input Error", JOptionPane.ERROR_MESSAGE);
            } 
        } else if (e.getSource() == btnRemove) {
            int indexSelected = list.getSelectedIndex();
            
            if (indexSelected != -1) {
                linkedList.remove(indexSelected);
                listModel.removeElementAt(indexSelected);
            } else {
                JOptionPane.showMessageDialog(this, "Please select item first", "Input Error", JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            listSampleApp app = new listSampleApp();
            app.setVisible(true);
        });
    }
}
